Options -Indexes
RewriteEngine On

# ── Serve existing files/dirs as-is (CSS, JS, images, fonts, etc.) ──
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── 301: redirect any direct .html request to the clean URL ──
# Skip index.html (root stays /)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ── Internally serve the .html file when clean URL is requested ──
# Root
RewriteRule ^$ index.html [L]

# Admin pages (inside /admin/ subfolder)
RewriteRule ^admin/?$               admin/login.html   [L]
RewriteRule ^admin/login/?$         admin/login.html   [L]
RewriteRule ^admin/dashboard/?$     admin/dashboard.html [L]
RewriteRule ^admin/add-update/?$    admin/add-update.html [L]
RewriteRule ^admin/edit-update/?$   admin/edit-update.html [L]

# Public pages (root level)
RewriteRule ^about/?$           about.html          [L]
RewriteRule ^gallery/?$         gallery.html        [L]
RewriteRule ^events-updates/?$  events-updates.html [L]
RewriteRule ^update-details/?$  update-details.html [L]

# Catch-all: if a file without extension exists as .html, serve it
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)/?$ $1.html [L]
